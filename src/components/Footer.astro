---
import { footerContact } from "../data/footer";
import RollLink from "./footer/RollLink.astro";
import SendButton from "./footer/SendButton.astro";
import ScrollProgressTop from "./footer/ScrollProgressTop.astro";

const year = new Date().getFullYear();
const { email, github, linkedin, telegram, location, timeZone } = footerContact;

const contactLinks = [
  { label: "GitHub", href: github },
  { label: "LinkedIn", href: linkedin },
  { label: "Telegram", href: telegram },
];
---

<style is:global>
  /* Footer portrait: grayscale base + colour layer revealed by a soft,
     cursor-tracked spotlight, wrapped in a subtle 3D depth tilt. Every live
     value is a CSS variable written by the client script, so no layout or
     transform properties are animated by hand. */
  .photo-hit {
    position: relative;
    perspective: 900px;
    border-radius: 2rem;
    /* Soft shadow that slides a few px opposite the tilt (--sh-x / --sh-y). */
    box-shadow: var(--sh-x, 0px) var(--sh-y, 14px) 30px -16px rgba(24, 24, 27, 0.5);
  }

  .photo-tilt {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    transform-style: preserve-3d;
    background: #fff;
    transform: translateZ(0);
  }

  /* Promote only while the pointer is over the photo. */
  .photo-hit.is-active .photo-tilt {
    will-change: transform;
  }

  .layer-bw {
    filter: grayscale(1);
  }

  .layer-color {
    -webkit-mask-image: radial-gradient(
      circle var(--r, 0px) at var(--x, 50%) var(--y, 50%),
      #000 0%,
      #000 55%,
      transparent 100%
    );
    mask-image: radial-gradient(
      circle var(--r, 0px) at var(--x, 50%) var(--y, 50%),
      #000 0%,
      #000 55%,
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .photo-hit.is-active .layer-color {
    will-change: mask-image;
  }

  /* Soft highlight that slides opposite the tilt (--sheen-x / --sheen-y). */
  .photo-sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    mix-blend-mode: soft-light;
    background: radial-gradient(
      circle at var(--sheen-x, 50%) var(--sheen-y, 50%),
      rgb(255 255 255 / var(--sheen-strength, 0.12)),
      rgb(255 255 255 / 0) 60%
    );
  }

  /* No movement wanted: full-colour photo, no mask, no tilt, no sheen. */
  @media (prefers-reduced-motion: reduce) {
    .photo-tilt {
      transform: none !important;
    }
    .layer-color {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .photo-sheen {
      display: none;
    }
  }
</style>

<footer id="site-footer" aria-label="Contact and site footer">
  <div data-footer-inner class="mx-auto w-full max-w-6xl px-6 pt-16 pb-8 sm:px-10 lg:px-12">
    <div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
      <h2 class="max-w-[16ch] text-[clamp(2.75rem,10vw,7.5rem)] font-medium leading-[0.92] tracking-tight text-[#363636]">
        Let’s work together.
      </h2>
      <div>
        <div
          data-photo
          style="--x: 50%; --y: 50%; --r: 0px;"
          class="photo-hit relative aspect-[4/5] h-44 w-36 sm:h-52 sm:w-40"
        >
          <div class="photo-tilt" data-photo-tilt>
            <img
              src="/profile-photo.jpg"
              width="736"
              height="736"
              alt="Portrait of Muhammad Abdulfgefar"
              loading="lazy"
              decoding="async"
              class="layer-bw absolute inset-0 h-full w-full object-cover"
            />
            <img
              src="/profile-photo.jpg"
              width="736"
              height="736"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class="layer-color absolute inset-0 h-full w-full object-cover"
            />
            <div class="photo-sheen" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>

    <form data-contact-form data-contact-email={email} novalidate class="mt-14 max-w-3xl">
      <div class="flex items-center gap-4">
        <div data-email-step class="min-w-0 flex-1">
          <label for="contact-email" class="sr-only">Your email address</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="your@email.com"
            aria-describedby="contact-status"
            class="w-full border-0 border-b border-[#363636]/25 bg-transparent pb-3 text-[clamp(1.25rem,3.4vw,2rem)] text-[#363636] outline-none transition-colors placeholder:text-[#c4c4c4] focus:border-[#990900] focus-visible:border-[#990900]"
          />
        </div>

        <div data-email-locked hidden class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-4 gap-y-1">
          <span data-locked-email class="text-[clamp(1.25rem,3.4vw,2rem)] text-[#c4c4c4]"></span>
          <button
            type="button"
            data-change-email
            class="text-[11px] font-medium uppercase tracking-[0.18em] text-gray-400 underline decoration-1 underline-offset-4 transition-colors hover:text-[#363636] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#990900] focus-visible:ring-offset-2"
          >
            change
          </button>
        </div>

        <SendButton label="Continue" />
      </div>

      <div id="contact-message-region" data-message-region hidden class="overflow-hidden" style="height: 0px">
        <div class="pt-8">
          <label for="contact-message" class="sr-only">What do you want to build?</label>
          <textarea
            id="contact-message"
            name="message"
            rows="3"
            minlength="10"
            maxlength="2000"
            placeholder="What do you want to build?"
            aria-describedby="contact-status"
            class="w-full resize-none border-0 border-b border-[#363636]/20 bg-transparent pb-3 text-[clamp(1.05rem,2.2vw,1.5rem)] leading-relaxed text-[#363636] outline-none transition-colors placeholder:text-[#c4c4c4] focus:border-[#990900] focus-visible:border-[#990900]"
          ></textarea>
        </div>
      </div>

      <p id="contact-status" data-status role="status" aria-live="polite" class="mt-5 min-h-[1.25rem] text-sm text-gray-500"></p>
      <p data-fallback role="status" aria-live="polite" hidden class="mt-1 text-sm text-gray-500">
        Couldn’t send. Check your connection, or email me directly at
        <a
          data-mailto
          href={`mailto:${email}`}
          class="text-[#363636] underline decoration-1 underline-offset-4 transition-colors hover:text-[#990900] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#990900] focus-visible:ring-offset-2"
          >{email}</a
        >
      </p>
      <p
        data-success
        role="status"
        tabindex="-1"
        hidden
        class="mt-5 flex items-center gap-3 text-[clamp(1.25rem,3vw,1.75rem)] text-[#363636] focus:outline-none"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-6 w-6 shrink-0 text-green-600"
          aria-hidden="true"
        >
          <path data-check-path d="M20 6 9 17l-5-5"></path>
        </svg>
        <span>Sent. I’ll reply soon.</span>
      </p>

      <div class="sr-only" aria-hidden="true">
        <label for="contact-company">Company (leave this empty)</label>
        <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </form>

    <nav aria-label="Contact links" class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-3">
      <div class="relative">
        <RollLink copy label="Email" />
        <span
          data-toast
          role="status"
          aria-live="polite"
          class="pointer-events-none absolute -top-8 left-0 rounded-full bg-[#363636] px-3 py-1 text-[10px] font-medium uppercase tracking-[0.18em] text-white opacity-0 transition-opacity duration-200"
          >Copied</span
        >
      </div>
      {
        contactLinks.map((link) => (
          <RollLink label={link.label} href={link.href} external />
        ))
      }
    </nav>

    <div class="mt-14 grid grid-cols-1 gap-3 border-t border-[#363636]/10 pt-6 text-[11px] font-medium uppercase tracking-[0.16em] text-gray-400 sm:grid-cols-3 sm:items-center">
      <p class="sm:text-left">© {year} Muhammad Abdulfgefar</p>
      <p
        data-live-time
        data-timezone={timeZone}
        aria-label={`Current time in ${location}`}
        class="font-mono normal-case tracking-normal sm:text-center"
      >
        {location} <time data-time>--:--</time>
      </p>
      <ScrollProgressTop class="justify-self-start sm:justify-self-end" />
    </div>
  </div>
</footer>

<script>
  import gsap from "gsap";
  import { MOTION } from "../lib/motion";
  import { initRollLinks, createSendButton, initScrollProgressTop } from "../lib/footer-motion";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const emailInput = form.querySelector<HTMLInputElement>("#contact-email");
    const emailStep = form.querySelector<HTMLElement>("[data-email-step]");
    const locked = form.querySelector<HTMLElement>("[data-email-locked]");
    const lockedEmail = form.querySelector<HTMLElement>("[data-locked-email]");
    const changeButton = form.querySelector<HTMLButtonElement>("[data-change-email]");
    const region = form.querySelector<HTMLElement>("[data-message-region]");
    const message = form.querySelector<HTMLTextAreaElement>("#contact-message");
    const actionButton = form.querySelector<HTMLButtonElement>("[data-action]");
    const status = form.querySelector<HTMLElement>("[data-status]");
    const fallback = form.querySelector<HTMLElement>("[data-fallback]");
    const success = form.querySelector<HTMLElement>("[data-success]");
    const checkPath = form.querySelector<SVGPathElement>("[data-check-path]");
    const honeypot = form.querySelector<HTMLInputElement>("#contact-company");
    const emailAddress = (form.dataset.contactEmail ?? "").trim();

    if (
      emailInput &&
      emailStep &&
      locked &&
      lockedEmail &&
      changeButton &&
      region &&
      message &&
      actionButton &&
      status &&
      fallback &&
      success &&
      honeypot
    ) {
      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const MESSAGE_MIN = 10;
      const MESSAGE_MAX = 2000;
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* One controller owns all GSAP work on the single action button. */
      const ctl = createSendButton(actionButton);

      /* Dev-only mock: ?mock=success / ?mock=error skips the network. */
      const mockParam = import.meta.env.DEV
        ? new URLSearchParams(window.location.search).get("mock")
        : null;
      const mockMode = mockParam === "success" || mockParam === "error" ? mockParam : null;

      type State = "idle" | "ready" | "sending" | "success" | "error";
      let step: "email" | "message" = "email";
      let state: State = "idle";

      const isEmailValid = () => EMAIL_RE.test(emailInput.value.trim());
      const isMessageValid = () => {
        const len = message.value.trim().length;
        return len >= MESSAGE_MIN && len <= MESSAGE_MAX;
      };

      const setStatus = (text: string) => {
        status.textContent = text;
      };
      const clearStatus = () => {
        status.textContent = "";
        fallback.hidden = true;
      };

      /* The single source of truth: icon, label, disabled and data-state all
         derive from `state` + `step`. Animations key off data-state. */
      const setState = (next: State) => {
        const prev = state;
        state = next;
        actionButton.dataset.state = state;
        actionButton.dataset.step = step;
        actionButton.disabled = state !== "ready";

        const label =
          state === "sending"
            ? "Sending"
            : step === "email"
              ? "Continue"
              : state === "idle"
                ? "Enter a message"
                : "Send message";
        ctl?.setLabel(label);

        if (state === "sending") {
          ctl?.setBusy(true);
        } else if (prev === "sending") {
          /* Restore the icon the spinner was hiding (no morph needed). */
          ctl?.setBusy(false);
        } else {
          /* Step 1 is always the arrow; step 2 morphs to the plane when ready. */
          ctl?.setIcon(step === "message" && state !== "idle" ? "plane" : "arrow");
        }
      };

      const openMessage = () => {
        lockedEmail.textContent = emailInput.value.trim();
        emailStep.hidden = true;
        locked.hidden = false;
        region.hidden = false;
        region.style.height = reduce ? "auto" : "0px";
        step = "message";
        document.documentElement.classList.add("is-message-open");
        setState(isMessageValid() ? "ready" : "idle"); // run the check once on open
        message.focus({ preventScroll: true });
        if (!reduce) {
          gsap.to(region, {
            height: "auto",
            duration: MOTION.footer.message.openDuration,
            ease: MOTION.footer.message.openEase,
            onComplete: () => {
              region.style.height = "auto";
            },
          });
        }
      };

      const closeMessage = () => {
        step = "email";
        document.documentElement.classList.remove("is-message-open");
        message.value = "";
        locked.hidden = true;
        emailStep.hidden = false;
        clearStatus();
        setState(isEmailValid() ? "ready" : "idle");
        emailInput.focus({ preventScroll: true });
        if (reduce) {
          region.hidden = true;
          region.style.height = "0px";
          return;
        }
        gsap.to(region, {
          height: 0,
          duration: MOTION.footer.message.openDuration,
          ease: MOTION.footer.message.openEase,
          onComplete: () => {
            region.hidden = true;
          },
        });
      };

      const delay = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

      /* Networked send with a hard 10s timeout. In dev, ?mock=… short-circuits. */
      const requestSend = async (payload: { email: string; message: string; company: string }) => {
        if (mockMode) {
          await delay(600);
          if (mockMode === "error") throw new Error("Mock error");
          return;
        }
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 10_000);
        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
            signal: controller.signal,
          });
          window.clearTimeout(timer);
          const data = (await res.json().catch(() => ({ ok: false }))) as { ok?: boolean; error?: string };
          if (!res.ok || !data.ok) throw new Error(data.error ?? "Request failed");
        } catch (err) {
          window.clearTimeout(timer);
          throw err;
        }
      };

      const playSuccess = async () => {
        document.documentElement.classList.remove("is-message-open");
        fallback.hidden = true;
        status.textContent = "";
        if (!reduce) await ctl?.flyOut();
        if (!reduce) {
          await new Promise<void>((resolve) => {
            gsap.to(region, {
              opacity: 0,
              duration: MOTION.footer.send.formFade.duration,
              ease: MOTION.footer.send.formFade.ease,
              onComplete: resolve,
            });
          });
        }
        emailStep.hidden = true;
        locked.hidden = true;
        region.hidden = true;
        region.style.height = "0px";
        region.style.opacity = "";
        actionButton.hidden = true;
        success.hidden = false;
        success.focus({ preventScroll: true });
        if (checkPath && !reduce) {
          const length = checkPath.getTotalLength();
          if (length) {
            gsap.fromTo(
              checkPath,
              { strokeDasharray: length, strokeDashoffset: length },
              {
                strokeDashoffset: 0,
                duration: MOTION.footer.send.check.duration,
                ease: MOTION.footer.send.check.ease,
              },
            );
          }
        }
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (step !== "message") {
          const value = emailInput.value.trim();
          if (!EMAIL_RE.test(value)) {
            emailInput.setAttribute("aria-invalid", "true");
            setStatus("That email doesn’t look right — try again.");
            emailInput.focus({ preventScroll: true });
            return;
          }
          emailInput.removeAttribute("aria-invalid");
          clearStatus();
          openMessage();
          return;
        }

        if (state === "sending") return;

        const text = message.value.trim();
        if (text.length < MESSAGE_MIN || text.length > MESSAGE_MAX) {
          setStatus(`Your message must be between ${MESSAGE_MIN} and ${MESSAGE_MAX} characters.`);
          message.focus({ preventScroll: true });
          return;
        }

        clearStatus();
        setStatus("Sending…");
        setState("sending");

        try {
          if (navigator.onLine === false) throw new Error("offline");
          await requestSend({ email: emailInput.value.trim(), message: text, company: honeypot.value });
          setState("success");
          await playSuccess();
        } catch {
          setState("error");
          if (!reduce) await ctl?.shake();
          setState("ready"); // return to the plane, ready to retry
          status.textContent = "";
          fallback.hidden = false; // inline "Couldn’t send…" + mailto (aria-live)
        }
      });

      emailInput.addEventListener("input", () => {
        emailInput.removeAttribute("aria-invalid");
        if (step === "email") {
          clearStatus();
          const next = isEmailValid() ? "ready" : "idle";
          if (next === "ready" && state === "idle") ctl?.pulse();
          setState(next);
        }
      });

      emailInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          form.requestSubmit();
        }
      });

      const onMessageChanged = () => {
        if (step !== "message" || state === "sending" || state === "success") return;
        clearStatus();
        const next = isMessageValid() ? "ready" : "idle";
        if (next === "ready" && state === "idle") ctl?.pulse();
        setState(next);
      };
      message.addEventListener("input", onMessageChanged);
      message.addEventListener("paste", () => window.setTimeout(onMessageChanged, 0));

      changeButton.addEventListener("click", closeMessage);

      /* ---- copy email + "Copied" toast ---- */
      const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
      const toast = document.querySelector<HTMLElement>("[data-toast]");
      if (copyButton && toast) {
        let timer = 0;
        copyButton.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(emailAddress);
          } catch {
            const scratch = document.createElement("textarea");
            scratch.value = emailAddress;
            scratch.setAttribute("readonly", "");
            document.body.appendChild(scratch);
            scratch.select();
            document.execCommand("copy");
            scratch.remove();
          }
          toast.style.opacity = "1";
          window.clearTimeout(timer);
          timer = window.setTimeout(() => {
            toast.style.opacity = "0";
          }, 1500);
        });
      }

      window.addEventListener(
        "beforeunload",
        () => {
          ctl?.revert();
        },
        { once: true },
      );
    }
  }

  /* ---- live Dire Dawa clock (updates every minute) ---- */
  const timeHost = document.querySelector<HTMLElement>("[data-live-time]");
  const timeEl = document.querySelector<HTMLElement>("[data-time]");
  if (timeHost && timeEl) {
    const timeZone = timeHost.dataset.timezone ?? "Africa/Addis_Ababa";
    const formatter = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
      timeZone,
    });
    const tick = () => {
      timeEl.textContent = formatter.format(new Date());
    };
    tick();
    const untilNextMinute = (60 - new Date().getSeconds()) * 1000;
    window.setTimeout(() => {
      tick();
      window.setInterval(tick, 60_000);
    }, untilNextMinute);
  }

  /* ---- footer micro-interactions: roll links + scroll-progress ring ---- */
  const motionCleanups = [initRollLinks(document), initScrollProgressTop()];
  window.addEventListener("beforeunload", () => motionCleanups.forEach((off) => off()), { once: true });
</script>

<script>
  import gsap from "gsap";
  import { MOTION } from "../lib/motion";

  /**
   * Footer portrait: a flashlight reveal plus a subtle 3D depth tilt.
   * A single pointer tracker on the stationary `.photo-hit` drives both, so
   * the spotlight mask stays accurate while the inner `.photo-tilt` rotates.
   *   Desktop: spotlight trails the cursor; the photo tilts toward it.
   *   Touch:   the spotlight drifts on a lissajous path (no tilt).
   */

  type QuickTo = ReturnType<typeof gsap.quickTo>;

  function initPhoto(): () => void {
    const hit = document.querySelector<HTMLElement>("[data-photo]");
    if (!hit) return () => {};
    const tilt = hit.querySelector<HTMLElement>("[data-photo-tilt]");
    // Reduced motion is handled entirely in CSS: full colour, no mask, no tilt.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return () => {};

    const cfg = MOTION.footer.spotlight;
    const tc = MOTION.footer.tilt;
    const noHover = window.matchMedia("(hover: none)").matches;
    const supports3d =
      typeof CSS !== "undefined" &&
      typeof CSS.supports === "function" &&
      CSS.supports("transform-style", "preserve-3d") &&
      CSS.supports("transform", "translateZ(1px)");
    const enableTilt = !noHover && supports3d && tilt !== null;

    const cleanups: Array<() => void> = [];

    /* Flashlight (px) and sheen/shadow state, all written out as CSS vars. */
    const pos = { x: 0, y: 0, r: 0 };
    const sheen = { x: 50, y: 50 };
    const shadow = { x: 0, y: tc.shadowY };

    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
    const fullRadius = () => hit.clientWidth * cfg.radiusFactor;

    const writeFlashlight = () => {
      hit.style.setProperty("--x", `${pos.x.toFixed(1)}px`);
      hit.style.setProperty("--y", `${pos.y.toFixed(1)}px`);
      hit.style.setProperty("--r", `${pos.r.toFixed(1)}px`);
    };
    const writeSheen = () => {
      hit.style.setProperty("--sheen-x", `${sheen.x.toFixed(2)}%`);
      hit.style.setProperty("--sheen-y", `${sheen.y.toFixed(2)}%`);
    };
    const writeShadow = () => {
      hit.style.setProperty("--sh-x", `${shadow.x.toFixed(2)}px`);
      hit.style.setProperty("--sh-y", `${shadow.y.toFixed(2)}px`);
    };

    hit.style.setProperty("--sheen-strength", String(tc.sheenOpacity));

    /* Tilt lives on a plain state object; a single onUpdate composes rotate +
       scale into one transform, so nothing fights over the transform string. */
    const tiltState = { rx: 0, ry: 0, s: 1, z: 0 };
    const writeTransform = () => {
      if (!tilt) return;
      tilt.style.transform =
        `translateZ(${tiltState.z.toFixed(2)}px) ` +
        `rotateX(${tiltState.rx.toFixed(3)}deg) ` +
        `rotateY(${tiltState.ry.toFixed(3)}deg) ` +
        `scale(${tiltState.s.toFixed(4)})`;
    };
    /* Rebuilt per hover so the elastic return can never leave a dead tween. */
    let tiltTweens: { rx: QuickTo; ry: QuickTo; s: QuickTo; z: QuickTo } | null = null;
    const buildTiltTweens = () => {
      const opts = { duration: tc.moveDuration, ease: tc.moveEase, onUpdate: writeTransform };
      tiltTweens = {
        rx: gsap.quickTo(tiltState, "rx", opts),
        ry: gsap.quickTo(tiltState, "ry", opts),
        s: gsap.quickTo(tiltState, "s", opts),
        z: gsap.quickTo(tiltState, "z", opts),
      };
    };

    const ctx = gsap.context(() => {
      const xTo = gsap.quickTo(pos, "x", { duration: cfg.moveDuration, ease: cfg.moveEase, onUpdate: writeFlashlight });
      const yTo = gsap.quickTo(pos, "y", { duration: cfg.moveDuration, ease: cfg.moveEase, onUpdate: writeFlashlight });
      const rTo = gsap.quickTo(pos, "r", { duration: cfg.growDuration, ease: cfg.growEase, onUpdate: writeFlashlight });

      const sxTo = gsap.quickTo(sheen, "x", { duration: tc.moveDuration, ease: tc.moveEase, onUpdate: writeSheen });
      const syTo = gsap.quickTo(sheen, "y", { duration: tc.moveDuration, ease: tc.moveEase, onUpdate: writeSheen });
      const shXTo = gsap.quickTo(shadow, "x", { duration: tc.moveDuration, ease: tc.moveEase, onUpdate: writeShadow });
      const shYTo = gsap.quickTo(shadow, "y", { duration: tc.moveDuration, ease: tc.moveEase, onUpdate: writeShadow });

      // Start centred so both modes begin inside the photo.
      pos.x = hit.clientWidth / 2;
      pos.y = hit.clientHeight / 2;
      writeFlashlight();
      writeSheen();
      writeShadow();

      if (noHover) {
        /* Touch: unchanged self-drifting flashlight — no tilt, no sheen move. */
        let interacting = false;
        let resumeTimer = 0;
        const phase = { t: 0 };

        rTo(fullRadius());

        const drift = gsap.to(phase, {
          t: Math.PI * 2,
          duration: cfg.driftDuration,
          ease: "none",
          repeat: -1,
          onUpdate: () => {
            if (interacting) return;
            xTo((0.5 + cfg.driftAmpX * Math.cos(phase.t)) * hit.clientWidth);
            yTo((0.5 + cfg.driftAmpY * Math.sin(phase.t * 2)) * hit.clientHeight);
          },
        });

        // Battery: only drift while the photo is on-screen and the tab is visible.
        let onScreen = true;
        let pageVisible = !document.hidden;
        const updateDrift = () => {
          if (onScreen && pageVisible) drift.resume();
          else drift.pause();
        };

        const io = new IntersectionObserver(
          (entries) => {
            onScreen = Boolean(entries[0]?.isIntersecting);
            updateDrift();
          },
          { threshold: 0 },
        );
        io.observe(hit);

        const onVisibility = () => {
          pageVisible = !document.hidden;
          updateDrift();
        };
        document.addEventListener("visibilitychange", onVisibility);
        updateDrift();

        const onDown = (event: PointerEvent) => {
          interacting = true;
          hit.classList.add("is-active");
          window.clearTimeout(resumeTimer);
          const rect = hit.getBoundingClientRect();
          xTo(event.clientX - rect.left);
          yTo(event.clientY - rect.top);
        };
        const onMove = (event: PointerEvent) => {
          if (!interacting) return;
          const rect = hit.getBoundingClientRect();
          xTo(event.clientX - rect.left);
          yTo(event.clientY - rect.top);
        };
        const settle = () => {
          window.clearTimeout(resumeTimer);
          resumeTimer = window.setTimeout(() => {
            interacting = false;
            hit.classList.remove("is-active");
          }, cfg.resumeDelay * 1000);
        };

        hit.addEventListener("pointerdown", onDown);
        hit.addEventListener("pointermove", onMove);
        hit.addEventListener("pointerup", settle);
        hit.addEventListener("pointercancel", settle);

        cleanups.push(() => {
          io.disconnect();
          document.removeEventListener("visibilitychange", onVisibility);
          window.clearTimeout(resumeTimer);
          hit.removeEventListener("pointerdown", onDown);
          hit.removeEventListener("pointermove", onMove);
          hit.removeEventListener("pointerup", settle);
          hit.removeEventListener("pointercancel", settle);
        });
      } else {
        /* Desktop: ONE shared tracker drives flashlight + tilt + sheen + shadow. */
        let active = false;

        /* Reads the cursor once per move, normalised to 0..1 over `.photo-hit`. */
        const point = (event: PointerEvent) => {
          const rect = hit.getBoundingClientRect();
          const nx = clamp01((event.clientX - rect.left) / rect.width);
          const ny = clamp01((event.clientY - rect.top) / rect.height);
          return { rect, nx, ny };
        };

        /* Tilt + light, all derived from the same normalised point. */
        const applyTilt = (nx: number, ny: number) => {
          if (!enableTilt) return;
          if (!tiltTweens) buildTiltTweens();
          const t = tiltTweens as { rx: QuickTo; ry: QuickTo; s: QuickTo; z: QuickTo };
          t.ry((nx - 0.5) * 2 * tc.maxAngle); // -max … +max, left → right
          t.rx((0.5 - ny) * 2 * tc.maxAngle); // +max … -max, top → bottom (leans to cursor)
          // Sheen slides opposite the tilt; shadow drifts opposite too.
          sxTo((1 - nx) * 100);
          syTo((1 - ny) * 100);
          shXTo((0.5 - nx) * tc.shadowShift);
          shYTo(tc.shadowY - (ny - 0.5) * tc.shadowShift);
        };

        const onEnter = (event: PointerEvent) => {
          active = true;
          hit.classList.add("is-active");
          const { rect, nx, ny } = point(event);
          // Snap the spotlight onto the pointer before it grows.
          pos.x = nx * rect.width;
          pos.y = ny * rect.height;
          writeFlashlight();
          rTo(fullRadius());
          if (enableTilt) {
            if (!tiltTweens) buildTiltTweens();
            const t = tiltTweens as { rx: QuickTo; ry: QuickTo; s: QuickTo; z: QuickTo };
            t.s(tc.maxScale);
            t.z(tc.lift);
          }
          applyTilt(nx, ny);
        };

        const onMove = (event: PointerEvent) => {
          if (!active) return;
          const { rect, nx, ny } = point(event);
          xTo(nx * rect.width);
          yTo(ny * rect.height);
          applyTilt(nx, ny);
        };

        const onLeave = () => {
          active = false;
          hit.classList.remove("is-active");
          rTo(0);
          if (enableTilt) {
            // Ease the tilt home (kills the per-hover quickTo tweens).
            gsap.to(tiltState, {
              rx: 0,
              ry: 0,
              s: 1,
              z: 0,
              duration: tc.returnDuration,
              ease: tc.returnEase,
              onUpdate: writeTransform,
              overwrite: "auto",
            });
            tiltTweens = null;
          }
          // Light returns to centre with the same smooth follow.
          sxTo(50);
          syTo(50);
          shXTo(0);
          shYTo(tc.shadowY);
        };

        hit.addEventListener("pointerenter", onEnter);
        hit.addEventListener("pointermove", onMove);
        hit.addEventListener("pointerleave", onLeave);

        const ro = new ResizeObserver(() => {
          if (active) rTo(fullRadius());
        });
        ro.observe(hit);

        cleanups.push(() => {
          ro.disconnect();
          hit.removeEventListener("pointerenter", onEnter);
          hit.removeEventListener("pointermove", onMove);
          hit.removeEventListener("pointerleave", onLeave);
        });
      }
    }, hit);

    return () => {
      cleanups.forEach((off) => off());
      gsap.killTweensOf(tiltState);
      if (tilt) gsap.killTweensOf(tilt);
      ctx.revert();
      hit.classList.remove("is-active");
      if (tilt) tilt.style.removeProperty("transform");
      hit.style.setProperty("--x", "50%");
      hit.style.setProperty("--y", "50%");
      hit.style.setProperty("--r", "0px");
    };
  }

  const cleanupPhoto = initPhoto();
  window.addEventListener("beforeunload", cleanupPhoto, { once: true });
</script>
