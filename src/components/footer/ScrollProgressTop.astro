---
interface Props {
  class?: string;
}

const { class: extraClass = "" } = Astro.props;
---

<button
  type="button"
  data-scroll-top
  aria-label="Back to top"
  class:list={[
    "group relative grid h-11 w-11 shrink-0 place-items-center rounded-full text-gray-400 transition-colors hover:text-[#990900] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#990900] focus-visible:ring-offset-2 focus-visible:ring-offset-white",
    extraClass,
  ]}
>
  <svg viewBox="0 0 44 44" class="absolute inset-0 h-full w-full -rotate-90" aria-hidden="true">
    <circle
      data-progress-track
      cx="22"
      cy="22"
      r="20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      opacity="0.15"
    ></circle>
    <circle
      data-progress-ring
      cx="22"
      cy="22"
      r="20"
      fill="none"
      stroke="#990900"
      stroke-width="1.5"
      stroke-linecap="round"
      pathLength="1"
      stroke-dasharray="1"
      stroke-dashoffset="1"
    ></circle>
  </svg>
  <svg
    data-progress-arrow
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5"
    aria-hidden="true"
  >
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</button>
