---
import { site } from "../data/site";

const socialIcons: Record<string, string> = {
  LinkedIn:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  GitHub:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  Telegram:
    '<path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 15 10"/>',
};
---

<footer class="site-footer">
  <div class="text-center">
    <div class="overflow-hidden">
      <div class="fadeup text-[#363636] font-medium uppercase text-xs">{site.location}</div>
    </div>
    <div class="overflow-hidden">
      <a href={`mailto:${site.email}`} class="fadeup text-gray-400 font-medium uppercase text-xs">
        {site.email}
      </a>
    </div>
  </div>
  <div class="social-links">
    {
      site.links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
          class="text-gray-400 transition-colors hover:text-[#363636]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6"
            set:html={socialIcons[link.label] ?? ""}
          />
        </a>
      ))
    }
  </div>
</footer>