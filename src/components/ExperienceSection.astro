---
import { projects } from "../data/projects";
import { experiences } from "../data/experience";

const stackPatterns = [
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-1",
  "bg-pattern-1",
  "bg-pattern-1",
  "bg-pattern-1",
  "bg-pattern-1",
  "bg-pattern-6",
];
const cardSlots = Array.from({ length: 18 });
---

<section class="relative -mt-64">
  <div class="min-h-96 md:min-h-[100vh]">
    <div data-stack-1 data-stack class="wrap__inner">
      <div class="content content--1">
        {
          cardSlots.map((_, index) => {
            const project = projects[index % projects.length];
            return (
              <div class="anim-card" style={`--card-i:${index}`}>
                <div class="card__img">
                  <div class={`shadow-lg flex rounded-3xl ${stackPatterns[index]} aspect-square`}>
                    {project.image && (
                      <img
                        src={project.image.src}
                        width={project.image.width}
                        height={project.image.height}
                        alt={project.name}
                        loading="lazy"
                        decoding="async"
                        class="object-contain w-11/12 rounded-3xl aspect-square m-auto"
                      />
                    )}
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
    <div class="text-center absolute top-0 left-0 w-full h-full">
      <div class="flex items-center justify-center h-full relative">
        <div class="-z-10 sticky">
          <h3 data-reveal="fade-up" class="fade-up text-5xl md:text-6xl lg:text-8xl font-bold text-gray-400 featured-title ml-12 uppercase">
            Experience
          </h3>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="exp-section pb-24 md:pb-36">
  <div class="mx-auto max-w-4xl px-6">
    {
      experiences.map((experience) => (
        <div class="exp-entry flex flex-col md:flex-row gap-6 md:gap-12 py-10">
          <div class="exp-index text-gray-300 md:w-40 flex-none">{experience.index}</div>
          <div class="flex-1">
            <h3 class="text-2xl md:text-3xl font-bold text-[#363636]">{experience.name}</h3>
            <p class="text-gray-500 mt-1">{experience.date}</p>
            <p class="mt-3 text-gray-600 leading-snug">{experience.description}</p>
            <p class="mt-3 uppercase text-xs tracking-widest text-[#363636]">{experience.tech}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>