---
import { projects } from "../data/projects";
import { experience } from "../data/experience";

const stackPatterns = [
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-6",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-3",
  "bg-pattern-1",
  "bg-pattern-1",
  "bg-pattern-1",
  "bg-pattern-1",
  "bg-pattern-1",
  "bg-pattern-6",
];
const cardSlots = Array.from({ length: 18 });
---

<section class="relative -mt-64">
  <div class="min-h-96 md:min-h-[100svh] grid place-content-center">
    <div data-stack-1 class="wrap__inner">
      <div class="content content--1">
        {
          cardSlots.map((_, index) => {
            const project = projects[index % projects.length];
            return (
              <div class="anim-card" style={`--card-i:${index}`}>
                <div class="card__img">
                  <div class={`shadow-lg flex rounded-lg ${stackPatterns[index]} aspect-square`}>
                    {project.image && (
                      <img
                        src={project.image.src}
                        width={project.image.width}
                        height={project.image.height}
                        alt={project.name}
                        loading="lazy"
                        decoding="async"
                        class="object-contain w-11/12 rounded-lg aspect-square m-auto"
                      />
                    )}
                  </div>
                </div>
                <span class="card-title">{project.name}</span>
                <span class="card-meta">{project.short}</span>
              </div>
            );
          })
        }
      </div>
    </div>
    <div class="text-center absolute top-0 left-0 w-full h-full">
      <div class="flex items-center justify-center h-full relative">
        <div class="-z-10 sticky">
          <h3 class="fade-up featured-title text-5xl md:text-6xl lg:text-8xl font-bold text-gray-400 ml-12 uppercase">
            Experience
          </h3>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="exp-section pb-24 md:pb-36">
  <div class="mx-auto w-full max-w-6xl px-6 lg:px-12">
    <ol class="exp-list">
      {
        experience.map((item) => {
          const label = item.link ? item.link.label.replace(/\s*→\s*$/, "") : "";
          return (
            <li data-reveal="exp-entry" class="exp-entry relative">
              <div
                data-reveal="exp-divider"
                aria-hidden="true"
                class="exp-divider h-px w-full origin-left bg-[#363636]/20"
              />

              <article class="grid grid-cols-1 gap-5 py-10 sm:py-12 md:grid-cols-[7rem_minmax(0,1fr)] md:gap-10 md:py-16">
                <div
                  data-reveal="exp-index"
                  aria-hidden="true"
                  class="exp-index font-mono text-[clamp(1.75rem,5vw,3rem)] font-light leading-none tabular-nums text-[#c2c2c2] md:pt-1"
                >
                  {item.index}
                </div>

                <div class="min-w-0">
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
                    <div data-exp-title class="min-w-0">
                      <h3 class="text-[clamp(1.5rem,3.2vw,2.5rem)] font-medium leading-[1.05] tracking-tight text-[#363636]">
                        <span class="block overflow-hidden">
                          <span data-reveal="exp-line" class="block">{item.org}</span>
                        </span>
                      </h3>
                      <p class="mt-2 text-base font-medium text-[#5c5c5c]">
                        <span class="block overflow-hidden">
                          <span data-reveal="exp-line" class="block">{item.role}</span>
                        </span>
                      </p>
                    </div>
                    <p
                      data-reveal="exp-meta"
                      class="shrink-0 font-mono text-[11px] uppercase tracking-[0.16em] text-[#6b6b6b] sm:pt-2 sm:text-right"
                    >
                      {item.period}
                    </p>
                  </div>

                  {
                    item.stats && item.stats.length > 0 && (
                      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Impact highlights">
                        {item.stats.map((stat) => (
                          <li
                            data-reveal="exp-stat"
                            class="rounded-full border border-[#990900]/25 bg-[#990900]/5 px-3 py-1 font-mono text-[11px] leading-none tracking-tight text-[#990900]"
                          >
                            {stat}
                          </li>
                        ))}
                      </ul>
                    )
                  }

                  <ul class="mt-7 max-w-2xl list-none space-y-3 border-l border-[#363636]/10 pl-5">
                    {item.bullets.map((bullet) => (
                      <li
                        data-reveal="exp-bullet"
                        class="relative text-[15px] leading-relaxed text-[#4a4a4a] before:absolute before:-left-5 before:top-[0.68em] before:h-1 before:w-1 before:-translate-x-1/2 before:rounded-full before:bg-[#c2c2c2]"
                      >
                        {bullet}
                      </li>
                    ))}
                  </ul>

                  <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <p
                      data-reveal="exp-meta"
                      class="max-w-xl text-[11px] uppercase leading-relaxed tracking-[0.12em] text-[#6b6b6b]"
                    >
                      <span class="text-[#5c5c5c]">Technologies:</span>{" "}
                      {item.tech}
                    </p>
                    {
                      item.link && (
                        <a
                          data-reveal="exp-meta"
                          href={item.link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="exp-link inline-flex shrink-0 items-center gap-1.5 self-start rounded-sm text-sm font-medium text-[#363636] underline-offset-4 transition-colors hover:text-[#990900] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#990900] focus-visible:ring-offset-4 focus-visible:ring-offset-white sm:self-auto"
                        >
                          <span>{label}</span>
                          <span data-exp-arrow aria-hidden="true" class="inline-block will-change-transform">
                            →
                          </span>
                        </a>
                      )
                    }
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
