const cardColors: Record<IconKey, string> = {
  react: "bg-[#353c45]",
  typescript: "bg-[#c92a2a]",
  node: "bg-[#5a5a5a]",
  flutter: "bg-[#0e7490]",
  python: "bg-[#c2850c]",
};
---

<section class="banner-section min-h-[calc(80vh)] md:min-h-[calc(90vh)] flex flex-col items-center justify-center">
  <div class="relative flex flex-col justify-center items-center gap-12">
    <div class="lg:mb-12">
      <h1 aria-label={`${site.firstName} ${site.lastName}`} data-parallax="hero" class="banner overflow-hidden relative text-center">
        <div class="title parent text-center overflow-hidden leading-none font-medium" aria-hidden="true">
          {site.firstName.toUpperCase()}
        </div>
        <div class="title parent text-center overflow-hidden leading-none font-medium" aria-hidden="true">
          {site.lastName.toUpperCase()}
        </div>
      </h1>
      <div class="sub-title overflow-hidden relative text-center">
        <div class="text-gray-500 text-xs subtitle text-center overflow-hidden leading-loose uppercase">
          {site.tagline}
        </div>
      </div>
    </div>
    <div class="cards-container card aspect-square">
      <div class="relative mx-auto stacked-cards aspect-square -z-10">
        {
          skills.map((skill) => (
            <div class={`${cardColors[skill.icon]} item rounded-2xl absolute aspect-square flex flex-col items-center justify-center text-white`}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                class="h-16 w-16 md:h-20 md:w-20"
                set:html={glyphs[skill.icon]}
              />
              <span class="text-xs sm:text-base md:text-lg mt-2">{skill.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>