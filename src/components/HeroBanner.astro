---
import { site } from "../data/site";
import { skills, type IconKey } from "../data/skills";

/* Original geometric glyphs — drawn here, not imported from anywhere. */
const glyphs: Record<IconKey, string> = {
  react:
    '<circle cx="12" cy="12" r="2.1"/><ellipse cx="12" cy="12" rx="10.5" ry="4.1"/><ellipse cx="12" cy="12" rx="10.5" ry="4.1" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10.5" ry="4.1" transform="rotate(120 12 12)"/>',
  typescript:
    '<rect x="2.5" y="2.5" width="19" height="19" rx="3.5"/><path d="M6.5 10.2h4.4M8.7 10.2v7.4" stroke-linecap="round"/><path d="M16.8 11a2.4 2.4 0 0 0-2.3 2.6c0 1.4 1 2 2.2 2.4 1 .3 1.6.7 1.6 1.5a1.9 1.9 0 0 1-1.9 1.7c-1 0-1.7-.5-2.1-1.3" stroke-linecap="round"/>',
  node: '<path d="M12 2.6 20.5 7.3v9.4L12 21.4 3.5 16.7V7.3z"/>',
  flutter:
    '<path d="M14.314 0L2.3 12 6 15.7 21.684.013h-7.357zm.014 11.072L7.857 17.53l6.47 6.47H21.7l-6.46-6.468 6.46-6.46h-7.37z" fill="currentColor" stroke="none"/>',
  python:
    '<path d="M12 3.2c-3 0-4.6 1.2-4.6 3.4v2.2h4.7" stroke-linecap="round"/><path d="M12 20.8c3 0 4.6-1.2 4.6-3.4v-2.2H11.9" stroke-linecap="round"/><rect x="7.4" y="8.8" width="9.2" height="6.4" rx="3.2"/><circle cx="10.2" cy="6" r="0.9" fill="currentColor" stroke="none"/><circle cx="13.8" cy="18" r="0.9" fill="currentColor" stroke="none"/>',
};

const cardColors: Record<IconKey, string> = {
  react: "bg-[#353c45]",
  typescript: "bg-[#c92a2a]",
  node: "bg-[#5a5a5a]",
  flutter: "bg-[#0e7490]",
  python: "bg-[#c2850c]",
};
---

<section class="banner-section min-h-[calc(80vh)] md:min-h-[calc(90vh)] flex flex-col items-center justify-center">
  <div class="relative flex flex-col justify-center items-center gap-12">
    <div class="lg:mb-12">
      <h1 aria-label={`${site.firstName} ${site.lastName}`} data-parallax="hero" class="banner overflow-hidden relative text-center">
        <div class="title parent text-center overflow-hidden leading-none font-medium" aria-hidden="true">
          {site.firstName.toUpperCase()}
        </div>
        <div class="title parent overflow-hidden text-center leading-tight font-medium" aria-hidden="true">
          {site.lastName.toUpperCase()}
        </div>
      </h1>
      <div class="sub-title overflow-hidden relative text-center">
        <div class="text-gray-500 text-xs subtitle text-center overflow-hidden leading-loose uppercase">
          {site.tagline}
        </div>
      </div>
    </div>
    <div class="cards-container card aspect-square">
      <div class="relative mx-auto stacked-cards aspect-square -z-10">
        {
          skills.map((skill) => (
            <div class={`${cardColors[skill.icon]} item rounded-2xl absolute aspect-square flex flex-col items-center justify-center text-white`}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                class="h-16 w-16 md:h-20 md:w-20"
                set:html={glyphs[skill.icon]}
              />
              <span class="text-xs sm:text-base md:text-lg mt-2">{skill.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>