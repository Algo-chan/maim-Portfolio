---
import { projects } from "../data/projects";
import { cta } from "../data/cta";

const slotClasses = [
  "bg-pattern-6",
  "bg-pattern-1",
  "bg-pattern-2",
  "bg-pattern-3",
  "bg-pattern-4",
  "bg-pattern-1",
  "bg-pattern-5 bg-green-500",
  "",
  "",
];
const fillerCount = Math.max(0, 9 - projects.length);
---

<section class="relative overflow-hidden">
  <div class="featured-container">
    <div class="featured-section">
      <div class="absolute top-10 overflow-hidden h-28 w-full">
        <h3 class="text-5xl md:text-6xl lg:text-8xl font-bold text-gray-400 featured-title ml-12 uppercase">Featured Work</h3>
      </div>
      <div class="featured-item-container z-30">
        {
          projects.map((project, index) => (
            <div
              class={`flex featured-item rounded-3xl aspect-square featured-card ${project.image ? "" : slotClasses[index % slotClasses.length]}`.trim()}
              style={project.bg ? `background-color:${project.bg}` : undefined}
            >
              {project.image && (
                <img
                  src={project.image.src}
                  width={project.image.width}
                  height={project.image.height}
                  alt={`${project.name} landing page`}
                  loading="lazy"
                  decoding="async"
                  class="object-contain w-11/12 rounded-3xl aspect-square m-auto"
                />
              )}
              <h3 class="inline-flex flex-col pl-6 text-2xl md:text-4xl font-bold text-white absolute bottom-0 left-0 p-4">
                <span>{project.name}</span>
                <span class="text-sm">{project.short}</span>
              </h3>
              <div class="featured-actions absolute bottom-0 right-0 p-4 flex items-center gap-2">
                {project.repoUrl && (
                  <a class="featured-btn" href={project.repoUrl} target="_blank" rel="noopener noreferrer">Code</a>
                )}
                {project.webUrl && (
                  <a class="featured-btn" href={project.webUrl} target="_blank" rel="noopener noreferrer">Live</a>
                )}
              </div>
            </div>
          ))
        }
        {
          Array.from({ length: fillerCount }).map((_, i) => (
            <div class={`featured-item aspect-square ${slotClasses[(projects.length + i) % slotClasses.length]}`.trim()}></div>
          ))
        }
      </div>
      <div class="featured-content-container min-h-screen flex items-center justify-center">
        <div class="max-w-4xl mx-auto">
          <p class="px-6 lg:px-2 text-gray-100 text-center mt-4 text-3xl md:text-4xl lg:text-5xl featured-content !leading-snug">
            {cta.featured}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>