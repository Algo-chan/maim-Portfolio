---
import "../styles/global.css";
import { SITE_URL } from "../lib/seo";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Shorter description used for Twitter cards */
  twitterDescription?: string;
  /** Absolute or site-relative URL to a card image (defaults to /og.png) */
  image?: string;
  /** Page URL used for og:url and canonical. Defaults to the current path. */
  url?: string;
  /** Standalone page: no site footer and no portfolio motion engine. */
  bare?: boolean;
}

const {
  title = "Muhammad Abdulfgefar | Full Stack Developer & Founder of FCN",
  description = "Full stack developer and founder of FCN, a live healthcare platform in Ethiopia. I build with React, Node.js and TypeScript, and think like an attacker.",
  twitterDescription = "Full stack developer and founder of FCN, a live healthcare platform in Ethiopia.",
  image = `${SITE_URL}/og.png`,
  url = `${SITE_URL}${Astro.url.pathname}`,
  bare = false,
} = Astro.props;

const ogImage = image.startsWith("http") ? image : `${SITE_URL}${image}`;
const ogImageAlt = "Muhammad Abdulfgefar, Full Stack Developer and Founder of FCN";

const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en" class={bare ? "is-standalone" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="zX1J1cgX-B_waC6YwCim2Cx1GZgYYSTyOFofY8QqzhM" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Muhammad Abdulfgefar" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/jpeg" href="/icon-512.jpg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.jpg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/futura-now-headline" />
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <!-- The page sits above the fixed footer and lifts to reveal it. -->
    <div id="page">
      <slot />
    </div>
    {!bare && <Footer />}
    <script>
      import { initMotion } from "../lib/motion";
      if (!document.documentElement.classList.contains("is-standalone")) {
        const cleanupMotion = initMotion();
        window.addEventListener("beforeunload", cleanupMotion, { once: true });
      }
    </script>
  </body>
</html>