---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HeroBanner from "../components/HeroBanner.astro";
import AboutSection from "../components/AboutSection.astro";
import FeaturedSection from "../components/FeaturedSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import Loader from "../components/Loader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
import { SITE_URL } from "../lib/seo";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Choppa",
  jobTitle: "Full Stack Developer",
  url: SITE_URL,
  image: `${SITE_URL}/og.png`,
  sameAs: site.links.map((link) => link.url),
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Dire Dawa University",
  },
  knowsAbout: ["React", "Node.js", "TypeScript", "PostgreSQL", "Cybersecurity"],
};
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <SiteHeader />
  <main class="overflow-x-hidden">
    <HeroBanner />
    <AboutSection />
    <FeaturedSection />
    <ExperienceSection />
  </main>
  <Loader />
  <SiteFooter />
</Layout>