# Canonical URL of the deployed site (used for sitemap/OG canonicals)
SITE_URL=https://your-domain.com

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics.
PUBLIC_GA_ID=

# --- Contact form (Resend) -------------------------------------------------
# Server-only secrets. Never prefix these with PUBLIC_ and never expose them
# to the client. Set the real values in Vercel → Settings → Environment
# Variables for Production, Preview and Development.
#
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=[EDIT ME]
# Inbox that receives contact messages.
CONTACT_TO_EMAIL=[EDIT ME]
# Optional "From" address. Must be a verified domain in Resend. If omitted,
# Resend's shared sandbox sender is used (onboarding@resend.dev), which only
# delivers to the Resend account owner's own address.
CONTACT_FROM_EMAIL=
